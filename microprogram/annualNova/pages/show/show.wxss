page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #fff;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.blacktoanalyze {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  height: 4vh;

  padding: 20rpx 20rpx;
  margin: 2rpx 55rpx 20rpx 55rpx;

  background: rgba(106, 172, 255, 0.3);
  border-radius: 12px;

  font-size: 40rpx;
  font-weight: 300;
  color: #FFFFFF;
}

.blacktoanalyze image {
  height: 60rpx;
  margin-right: 30rpx;
}

.show-container {
  height: 86vh;
  margin: 20rpx 55rpx 20rpx 55rpx;
  background: #F7F9FB;
  border-radius: 40rpx;
}

.divider {
  height: 1px;
  width: 90%;
  margin: 0 auto;
  /* 使用自动左右外边距实现居中对齐 */
  position: relative;
  background-color: #ddd;
  border-width: 0;
}


.report {
  display: flex;
  flex: 1;
  flex-direction: row;
  height: 20vh;

  background: #F7F9FB;
  border-radius: 30rpx;
  padding: 20rpx 50rpx;
}

.report-right {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-items: end;
  width: 60%;
  margin: auto 0;
  margin-left: 30rpx;
}

.reupload {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-items: center;

  margin: auto 16px;
  margin-left: 0;
  padding: 15rpx 30rpx;
  background: #6AACFF;
  border-radius: 24rpx;
  /* box-shadow: 0 6px 10px  #7ab6ff; */

  font-weight: 300;
  font-size: 26rpx;
  letter-spacing: 0.02em;
  color: #FFFFFF;
}

.reupload image {
  margin: 0 15rpx 0 0;
  height: 55rpx;
}

.report image {
  height: 40rpx;
}

.report .cover {
  width: 13vh;
  height: 16vh;
  background: #D9D9D9;
  margin: 40rpx 10rpx;
}

.report .reportName {
  padding-bottom: 30rpx;

  font-size: 20px;
  font-weight: 550;

  text-align: left;
  white-space: normal;
  text-overflow: ellipsis;
  display: -webkit-box;
  /* -webkit-line-clamp: 1; */
  -webkit-box-orient: vertical;
}

.totalscore {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 5vh;

  padding : 0 10rpx 20rpx 30rpx;

  font-size: 20px;
  font-weight: 550;
  letter-spacing: 0.02em;
  text-align: left;
}

.totalscore image {
  height: 50rpx;
  margin-left: 30rpx;
}

.summary {
  height: 46vh;
  padding: 0rpx 30rpx 0 30rpx;
  box-sizing: border-box;
  width: 100%;
}

.summary .title {
  padding: 30rpx 0;

  font-size: 40rpx;
  font-weight: 550;
}

.summary .content {
  padding-left: 33rpx;
  padding-bottom: 30rpx;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 50rpx;
  letter-spacing: 0.12em;
  text-align: left;

}

.upload-button {
  display: flex;
  align-items: center;

  margin: 2vh auto;
  padding: 8rpx 25rpx 8rpx 20rpx;
  background: #6AACFF;
  border-radius: 24rpx;
  box-shadow: 0 6px 10px  #7ab6ff;

  font-weight: lighter;
  font-size: 35rpx;
  letter-spacing: 0.12em;
  color: #FFFFFF;
}

.upload-button image {
  height: 60rpx;
  margin-right: 20rpx;
}

.bottom-container {
  display: flex;
  height: 15vh;
  flex-direction: column;
}