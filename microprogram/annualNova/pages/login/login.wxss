/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient( #fff,#bad4f3);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.bg-img {
  width: 100%;
  height: 100%;
  position: fixed;
  z-index: -1;
}
.bg-color {
  width: 100%;
  height: 100%;
  background-color: #6AACFF;
}
.login {
  font-size: 5.5vw;
  padding: 4vw;
  color: white;
  background: #6AACFF;
  border-radius: 12px;
}
