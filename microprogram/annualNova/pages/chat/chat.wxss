page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #fff;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.blacktoanalyze {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;

  padding: 30rpx 20rpx;
  margin: 2rpx 55rpx 20rpx 55rpx;

  background: rgba(106, 172, 255, 0.3);
  border-radius: 12px;

  font-size: 40rpx;
  font-weight: 350;
  color: #FFFFFF;
}

.blacktoanalyze image {
  height: 60rpx;
  margin-right: 30rpx;
}

.divider {
  height: 1px;
  width: 90%;
  margin: 0 auto;
  /* 使用自动左右外边距实现居中对齐 */
  position: relative;
  background-color: #ddd;
  border-width: 0;
}

.today-annual {
  display: flex;
  margin: 20rpx 30rpx 20rpx 0;
}

.today-annual .annualtitle {
  align-self: center;
  font-weight: bold;
  color: rgba(0, 0, 0, 0.8);

  text-align: left;
  white-space: normal;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.today-annual image {
  width: 60rpx;
  height: 60rpx;
  margin: 0 20rpx 0 25rpx;
}

.avatar-self {
  margin: 0 0 0 25rpx;
  width: 60rpx;
  height: 60rpx;
}

.avatar-bot {
  margin-right: 20rpx;
  width: 60rpx;
  height: 60rpx;
}

.mechat {
  display: flex;
  flex-direction: row-reverse;
  margin: 20rpx 50rpx 20rpx 30rpx;
}

.botchat {
  display: flex;
  flex-direction: row;
  margin: 20rpx 30rpx 20rpx 50rpx;

}

.msg {
  align-self: center;
  font-weight: lighter;
  color: rgba(0, 0, 0, 0.9);
  padding: 10rpx;
  line-height: 1.8em;
}

.grayBG {
  background: #F7F9FB;
  border-radius: 0 20rpx 30rpx 30rpx;
}

.report {
  display: flex;
  flex-direction: row;

  height: 200rpx;
  background: #F7F9FB;
  border-radius: 30rpx;
  margin: 20rpx 50rpx;
}

.report .cover {
  width: 124rpx;
  height: 134rpx;
  background: #D9D9D9;
  margin: auto 40rpx;
}

.report .reportName {
  margin: auto;
  margin-right: 30rpx;
  margin-left: 0;
  padding-bottom: 30rpx;

  text-align: left;
  white-space: normal;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.input-container {
  
  position: fixed;
  left: 0;
  right: 0;

  height: 17vh;
  box-sizing: border-box;
  background: #F7F9FB;
  border-radius: 24px;
  margin: 10rpx 40rpx;
  padding: 20rpx 35rpx;
  border: 1px solid #6AACFF;
}

.text-area {
  height: 10vh;

  font-size: 32rpx;
  margin-right: 16rpx;

  font-weight: 400;
  line-height: 20px;
  /* identical to box height */
  letter-spacing: 0.02em;

  color: rgba(0, 0, 0, 0.8);
}

.input-container image {
  width: 40rpx;
}

.submit-button {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;

  background: #6AACFF;
  border-radius: 12px;
  margin-left: auto;
  padding: 8rpx 30rpx 6rpx 20rpx;

  font-weight: 500;
  font-size: 35rpx;
  color: #FFFFFF;
}

.submit-button image {
  height: 50rpx;
  margin-right: 15rpx;
}

.bottom {
  display: flex;
}

.bottomicon {
  margin-top: auto;
  height: 50rpx;
}